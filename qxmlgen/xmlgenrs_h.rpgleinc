**free
      //%METADATA                                                      *
      // %TEXT XMLGENRS Exported Prototypes                            *
      //%EMETADATA                                                     *
/if not defined(XMLGENRS_H)
/define XMLGENRS_H

dcl-s string_t varchar(2000) based(pDummy);

// Define function prototype to open script file
dcl-pr openScript ind extproc('XMLGENRS_openScript');
  i_file char(10) value;
  i_lib char(10) value;
  i_mbr char(10) value;
end-pr;

// Define function prototype to setll in script file
dcl-pr setllScript extproc('XMLGENRS_setllScript');
  i_rcdNbr int(10) value;
end-pr;

// Define function prototype to read from script file
dcl-pr readScript ind extproc('XMLGENRS_readScript');
  o_line varchar(240);
end-pr;

// Define function prototype to load a multi-line string from script file
dcl-pr loadScriptString like(string_t) extproc('XMLGENRS_loadScriptString');
  i_line varchar(240) value;
end-pr;

// Define procedure prototype to close script file
dcl-pr closeScript extproc('XMLGENRS_closeScript') end-pr;

// Define function prototype to open XML file
dcl-pr openXML ind extproc('XMLGENRS_openXML');
  i_file char(10) value;
  i_lib char(10) value;
  i_mbr char(10) value;
  i_mode char(10) value;
end-pr;

// Define function prototype to read from XML file
dcl-pr readXML ind extproc('XMLGENRS_readXML');
  o_line varchar(240);
end-pr;

// Define function prototype to write to XML file
dcl-pr writeXML extproc('XMLGENRS_writeXML');
  i_line varchar(240) value;
end-pr;

// Define function prototype to write a multi-line string to XML file
dcl-pr writeXMLString extproc('XMLGENRS_writeXMLString');
  i_string like(string_t) value;
end-pr;

// Define procedure prototype to close XML file
dcl-pr closeXML extproc('XMLGENRS_closeXML') end-pr;

// Define function prototype to open member file
dcl-pr openMbr ind extproc('XMLGENRS_openMbr');
  i_file char(10) value;
  i_lib char(10) value;
  i_mbr char(10) value;
end-pr;

// Define function prototype to read from member file
dcl-pr readMbr ind extproc('XMLGENRS_readMbr');
  o_line varchar(240);
end-pr;

// Define procedure prototype to close member file
dcl-pr closeMbr extproc('XMLGENRS_closeMbr') end-pr;

// Define function prototype to get Member CCSID
dcl-pr getMbrCCSID uns(5) extproc('XMLGENRS_getMbrCCSID') end-pr;

// Define function prototype to get Member record length
dcl-pr getMbrRcdLen int(5) extproc('XMLGENRS_getMbrRcdLen') end-pr;

// Define function prototype to remove preceeding and trailing quotes from a string
dcl-pr rmvQuotes like(string_t) extproc('XMLGENRS_rmvQuotes');
  i_string like(string_t) value;
end-pr;

// Define function prototype to replace double quotes by quotes
dcl-pr rmvDblQuotes like(string_t) extproc('XMLGENRS_rmvDblQuotes');
  i_string like(string_t) value;
end-pr;

// Define function prototype to replace all occurences of a token in a string
dcl-pr replace like(string_t) extproc('XMLGENRS_replace');
  i_token like(string_t) value;
  i_string like(string_t) value;
  i_value like(string_t) value;
end-pr;

// Define function prototype to check whether a string starts with a given string
dcl-pr startsWith ind extproc('XMLGENRS_startsWith');
  i_prefix like(string_t) value;
  i_string like(string_t) value;
end-pr;

// Define function prototype to format a CL command
dcl-pr fmtClCmd like(string_t) extproc('XMLGENRS_fmtClCmd');
  i_cmd like(string_t) value;
end-pr;

// Define function prototype to remove comments from a CL String
dcl-pr rmvClRem like(string_t) extproc('XMLGENRS_rmvClRem');
  i_clCmd like(string_t) value;
end-pr;

// Define function prototype to get keyword data from a string
dcl-pr getKwdData like(string_t) extproc('XMLGENRS_getKwdData');
  i_keyWord char(10) value;
  i_string like(string_t) value;
end-pr;

// Define function prototype to get a field name from string
dcl-pr getFldName varchar(10) extproc('XMLGENRS_getFldName');
  i_keyWord char(10) value;
  i_string like(string_t) value;
end-pr;

// Define function prototype to get attribute data from a string
dcl-pr getAttrData like(string_t) extproc('XMLGENRS_getAttrData');
  i_attr char(10) value;
  i_string like(string_t) value;
end-pr;

// Define function prototype check for an object
dcl-pr chkobj ind extproc('XMLGENRS_chkobj');
  i_obj char(10) value;
  i_lib char(10) value;
  i_type char(10) value;
  i_mbr char(10) value options(*nopass);
end-pr;

// Define procedure prototype to send a message
dcl-pr sndMessage extproc('XMLGENRS_sndMessage');
  i_msgID char(7) value;
  i_msgText varchar(512) value;
  i_msgType char(10) value;
  i_msgFile char(10) value options(*nopass);
  i_msgLib char(10) value options(*nopass);
end-pr;

// Define procedure prototype to ensure string length between module
dcl-pr ensureStringLength extproc('XMLGENRS_ensureStringLength');
  i_size int(10) value;
end-pr;

// Define procedure prototype of C like assert macro
dcl-pr assert extproc('XMLGENRS_assert');
  i_condition ind value;
  i_text char(128) value;
  i_procedure char(128) value options(*nopass);
end-pr;

// Define function prototype to convert to upper case
dcl-pr uCase like(string_t) extproc('XMLGENRS_uCase');
  i_string like(string_t) value;
end-pr;

// Define function prototype to retrieve member text
dcl-pr getMbrTxt char(50) extproc('XMLGENRS_getMbrTxt');
  i_file char(10) value;
  i_lib char(10) value;
  i_mbr char(10) value;
end-pr;

// Retrieves version information from the specified source member
dcl-pr getVersionInfo varchar(15) extproc('XMLGENRS_getVersionInfo');
  i_file char(10) value;
  i_lib char(10) value;
  i_mbr char(10) value;
end-pr;

/endif
